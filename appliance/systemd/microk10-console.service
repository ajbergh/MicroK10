[Unit]
Description=MicroK10 Appliance Console
After=network.target
Conflicts=getty@tty1.service
ConditionPathExists=/opt/microk10/appliance/microk10-tui

[Service]
Type=simple
ExecStart=/opt/microk10/appliance/microk10-tui
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
